{
  "name": "tun-ideas",
  "productName": "Tun Ideas",
  "version": "1.1.0",
  "description": "Phòng họp nơi các AI tranh luận về ý tưởng của bạn",
  "author": "Tun Ideas",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node desktop/server.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "vn.tunideas.app",
    "productName": "Tun Ideas",
    "files": ["desktop/**", "web/**", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis"], "icon": "desktop/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tun Ideas",
      "artifactName": "TunIdeas-Setup-${version}.exe"
    }
  }
}
